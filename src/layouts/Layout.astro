---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Kacper Tucholski — Nyjako",
    description = "Systems-leaning developer working across C, C++, Rust and full-stack web — OS internals, TUIs, and tools built to fix real, specific annoyances.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
        <meta name="description" content={description} />
        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>

<script>
    import { animate, stagger, onScroll } from "animejs";

    const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const groups = document.querySelectorAll<HTMLElement>(
        "[data-reveal-group]",
    );

    groups.forEach((group) => {
        const items = Array.from(
            group.querySelectorAll<HTMLElement>("[data-reveal]"),
        );
        if (!items.length) return;

        if (prefersReduced) {
            items.forEach((el) => {
                el.style.opacity = "1";
                el.style.transform = "none";
            });
            return;
        }

        animate(items, {
            opacity: [0, 1],
            translateY: [18, 0],
            duration: 550,
            ease: "outQuad",
            delay: stagger(60),
            autoplay: onScroll({
                target: group,
                enter: "bottom-=8% top",
            }),
        });
    });
</script>
